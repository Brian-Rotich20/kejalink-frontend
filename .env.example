# KejaLink frontend. Copy to .env.local for development. Blank values count as unset.

# Canonical public origin of this site (metadata, sitemap, OG images).
# Vercel previews fall back to the deployment URL when this is blank.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin of the Fastify API for server-to-server calls (the /api proxy and server rendering).
# Default: https://kejalink-api.onrender.com. Local backend: http://127.0.0.1:5000
API_INTERNAL_URL=

# Optional. Leave blank so the browser always talks to this site's /api proxy (first-party cookies).
# Only set it after moving app and API to one registrable domain (e.g. https://api.kejalink.co.ke).
NEXT_PUBLIC_API_BASE=

# Support address shown where V1 has no self-service flow (password reset, appeals).
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional. Server wait for the API before giving up, in ms (Render cold starts take up to ~60 s).
API_TIMEOUT_MS=
